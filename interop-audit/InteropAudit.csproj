<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(SVS_GAME_DIR)</GameDir>
    <CecilPath Condition="'$(CecilPath)' == ''">$(GameDir)\BepInEx\core\Mono.Cecil.dll</CecilPath>
  </PropertyGroup>
  <ItemGroup><Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath></Reference></ItemGroup>
</Project>
